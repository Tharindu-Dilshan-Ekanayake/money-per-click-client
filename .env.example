# Copy to `.env.local` to override anything here. Nothing in this file is secret.

# The game on Bloxity (My Games). Game id = slug for this game.
VITE_GAME_SLUG=1-money-per-click
VITE_LEGION_GAME_ID=1-money-per-click

# Bloxity endpoints. Leave these as-is unless you are running the portal locally.
# They MUST be set: without them the SDK repoints itself at localhost when it
# detects a dev server, and the login popup can never return a token.
VITE_BLOXITY_PORTAL_URL=https://bloxity.io
VITE_BLOXITY_API_URL=https://api.bloxity.io

# --- Local development only (see .env.development) -------------------------
# Your local money-per-click-server (`npm run dev` there, port 2567):
#   VITE_API_URL       leaderboard HTTP API
#   VITE_COLYSEUS_URL  multiplayer socket, straight to the server
# Never set these for a Boxity build: there the game finds its backend from the
# page host and joins multiplayer through the Boxity matchmaker.
# VITE_API_URL=http://localhost:2567
# VITE_COLYSEUS_URL=ws://localhost:2567
